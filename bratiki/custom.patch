+    private fun drawWires(c: Canvas) {
+        p.style=Paint.Style.STROKE;p.strokeCap=Paint.Cap.ROUND
+        for(w in wires) {
+            val mx=(w[0]+w[2])*.5f;val my=max(w[1],w[3])+w[4]+sin(phase*1.9f+w[5])*2.4f
